page {
  --primary: #07c160;
  --bg: #f5f5f5;
  --text: #333333;
  --text-secondary: #999999;
  --border: #e5e5e5;
  --danger: #ee0a24;

  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', sans-serif;
  font-size: 28rpx;
  color: var(--text);
  background-color: var(--bg);
  box-sizing: border-box;
}
