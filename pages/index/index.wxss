.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg);
}

.empty-state {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.list {
  flex: 1;
  padding: 24rpx;
}

.record-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  position: relative;
}

.record-thumb {
  width: 120rpx;
  height: 160rpx;
  border-radius: 8rpx;
  background: #eee;
}

.record-info {
  flex: 1;
  margin-left: 24rpx;
}

.record-title {
  font-size: 30rpx;
  color: var(--text);
  display: block;
  margin-bottom: 8rpx;
}

.record-pages {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.record-delete {
  padding: 12rpx 24rpx;
  font-size: 26rpx;
  color: var(--danger);
}

.bottom-bar {
  padding: 24rpx;
  display: flex;
  justify-content: center;
  background: #fff;
  border-top: 1rpx solid var(--border);
}

.scan-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.scan-btn-icon {
  width: 112rpx;
  height: 112rpx;
  line-height: 112rpx;
  text-align: center;
  background: var(--primary);
  color: #fff;
  font-size: 60rpx;
  border-radius: 56rpx;
  margin-bottom: 8rpx;
}

.scan-btn-text {
  font-size: 24rpx;
  color: var(--text-secondary);
}
