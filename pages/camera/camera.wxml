<view class="page">
  <camera class="camera" device-position="back" flash="auto" />

  <!-- 轻量取景辅助线：四个角标 -->
  <view class="guide-overlay">
    <view class="guide-corners">
      <view class="gc tl" />
      <view class="gc tr" />
      <view class="gc bl" />
      <view class="gc br" />
    </view>
  </view>

  <!-- 底部控制栏 -->
  <view class="bottom-controls">
    <view class="btn-side" bindtap="onAlbumImport">
      <text>相册</text>
    </view>
    <view class="shutter" bindtap="onTakePhoto">
      <view class="shutter-inner" />
    </view>
    <view class="btn-side" bindtap="onClose">
      <text>关闭</text>
    </view>
  </view>

  <!-- 多页计数 -->
  <view wx:if="{{multiPageMode}}" class="page-badge">
    <text>已拍 {{pages.length || 1}} 页</text>
  </view>
</view>
