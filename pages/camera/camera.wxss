.page {
  position: relative;
  width: 100vw;
  height: 100vh;
  background: #000;
}

.camera {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

/* 取景辅助角标 */
.guide-overlay {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 10;
  pointer-events: none;
}

.guide-corners {
  position: relative;
  width: 540rpx;
  height: 400rpx;
}

.gc {
  position: absolute;
  width: 48rpx;
  height: 48rpx;
  border-color: rgba(255, 255, 255, 0.7);
  border-style: solid;
  border-width: 0;
}

.tl { top: 0; left: 0;   border-top-width: 5rpx; border-left-width: 5rpx;  border-radius: 8rpx 0 0 0; }
.tr { top: 0; right: 0;  border-top-width: 5rpx; border-right-width: 5rpx; border-radius: 0 8rpx 0 0; }
.bl { bottom: 0; left: 0; border-bottom-width: 5rpx; border-left-width: 5rpx; border-radius: 0 0 0 8rpx; }
.br { bottom: 0; right: 0; border-bottom-width: 5rpx; border-right-width: 5rpx; border-radius: 0 0 8rpx 0; }

/* 底部控制栏 */
.bottom-controls {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  padding: 40rpx 60rpx 80rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  z-index: 20;
  background: linear-gradient(transparent, rgba(0,0,0,0.5));
}

.btn-side {
  padding: 16rpx 32rpx;
}

.btn-side text {
  font-size: 28rpx;
  color: #fff;
}

.shutter {
  width: 128rpx;
  height: 128rpx;
  border-radius: 64rpx;
  border: 5rpx solid #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.shutter-inner {
  width: 104rpx;
  height: 104rpx;
  border-radius: 52rpx;
  background: #fff;
}

/* 多页计数 */
.page-badge {
  position: absolute;
  top: 80rpx;
  left: 0;
  width: 100%;
  text-align: center;
  z-index: 20;
}

.page-badge text {
  color: #fff;
  font-size: 26rpx;
  background: rgba(0,0,0,0.4);
  padding: 8rpx 24rpx;
  border-radius: 16rpx;
}
